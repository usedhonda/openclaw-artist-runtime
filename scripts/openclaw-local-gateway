#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
source "${script_dir}/openclaw-local-env.sh"

command="${1:-run}"
if [[ $# -gt 0 ]]; then
  shift
fi

common_args=(
  --allow-unconfigured
  --bind "${OPENCLAW_LOCAL_GATEWAY_BIND}"
  --auth "${OPENCLAW_LOCAL_GATEWAY_AUTH}"
  --port "${OPENCLAW_LOCAL_GATEWAY_PORT}"
)

launchd_label="com.openclaw.artist-runtime.gateway"
launchd_service_target="gui/$(id -u)/${launchd_label}"
supervisor_lock="${OPENCLAW_LOCAL_WORKSPACE}/runtime/gateway-supervisor.lock"

ensure_runtime_dirs() {
  mkdir -p "${OPENCLAW_LOCAL_ROOT}" "${OPENCLAW_HOME}" "${OPENCLAW_STATE_DIR}" "${OPENCLAW_LOCAL_WORKSPACE}" "${OPENCLAW_LOCAL_LOGS}" "$(dirname "${OPENCLAW_CONFIG_PATH}")"
}

ensure_gateway_config() {
  node <<'EOF'
const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");

const configPath = process.env.OPENCLAW_CONFIG_PATH;
if (!configPath) {
  process.exit(0);
}

let config = {};
try {
  config = JSON.parse(fs.readFileSync(configPath, "utf8"));
} catch {
  config = {};
}

config.gateway ??= {};
const bind = process.env.OPENCLAW_LOCAL_GATEWAY_BIND;
if (typeof bind === "string" && bind.trim().length > 0) {
  config.gateway.bind = bind.trim();
}
config.gateway.auth ??= {};
const authMode = process.env.OPENCLAW_LOCAL_GATEWAY_AUTH;
if (typeof authMode === "string" && authMode.trim().length > 0) {
  config.gateway.auth.mode = authMode.trim();
} else if (typeof config.gateway.auth.mode !== "string" || config.gateway.auth.mode.trim().length === 0) {
  config.gateway.auth.mode = "none";
}
if (typeof config.gateway.auth.token !== "string" || config.gateway.auth.token.trim().length === 0) {
  config.gateway.auth.token = crypto.randomBytes(24).toString("hex");
}

config.channels ??= {};
config.channels.telegram ??= {};
const telegramStreaming = config.channels.telegram.streaming;
if (telegramStreaming === undefined) {
  config.channels.telegram.streaming = {
    mode: "partial",
    preview: { toolProgress: false }
  };
} else if (telegramStreaming && typeof telegramStreaming === "object" && !Array.isArray(telegramStreaming)) {
  telegramStreaming.preview ??= {};
  if (typeof telegramStreaming.preview.toolProgress !== "boolean") {
    telegramStreaming.preview.toolProgress = false;
  }
}

config.messages ??= {};
config.messages.visibleReplies = "automatic";

config.tools ??= {};
const requiredToolDenies = ["group:runtime", "write", "edit", "apply_patch", "gateway"];
const configuredToolDenies = Array.isArray(config.tools.deny) ? config.tools.deny : [];
config.tools.deny = [...new Set([...configuredToolDenies, ...requiredToolDenies])];

fs.mkdirSync(path.dirname(configPath), { recursive: true });
fs.writeFileSync(configPath, `${JSON.stringify(config, null, 2)}\n`, "utf8");
EOF
}

read_gateway_token() {
  node <<'EOF'
const fs = require("node:fs");

const configPath = process.env.OPENCLAW_CONFIG_PATH;
if (!configPath) {
  process.exit(0);
}

try {
  const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
  const token = typeof config.gateway?.auth?.token === "string" ? config.gateway.auth.token.trim() : "";
  if (token) {
    process.stdout.write(token);
  }
} catch {}
EOF
}

read_gateway_pid() {
  if [[ -f "${OPENCLAW_LOCAL_GATEWAY_PID}" ]]; then
    tr -d '[:space:]' < "${OPENCLAW_LOCAL_GATEWAY_PID}"
  fi
}

gateway_pid_is_live() {
  local pid="$1"
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

cleanup_stale_pid() {
  local pid
  pid="$(read_gateway_pid)"
  if [[ -n "${pid}" ]] && ! gateway_pid_is_live "${pid}"; then
    rm -f "${OPENCLAW_LOCAL_GATEWAY_PID}"
  fi
}

launchd_service_loaded() {
  command -v launchctl >/dev/null 2>&1 && launchctl print "${launchd_service_target}" >/dev/null 2>&1
}

launchd_service_pid() {
  launchctl print "${launchd_service_target}" 2>/dev/null \
    | awk '$1 == "pid" && $2 == "=" && $3 ~ /^[0-9]+$/ { print $3; exit }'
}

live_supervisor_lock_owner() {
  local owner_pid=""
  if [[ -f "${supervisor_lock}" ]]; then
    owner_pid="$(tr -d '[:space:]' < "${supervisor_lock}" 2>/dev/null || true)"
  fi
  if [[ -n "${owner_pid}" ]] && gateway_pid_is_live "${owner_pid}" \
    && ps -o args= -p "${owner_pid}" 2>/dev/null | grep -Fq "openclaw-local-gateway-supervisor"; then
    printf '%s\n' "${owner_pid}"
  fi
}

launchd_owner_state() {
  # 0 = launchd owns a live supervisor, 1 = launchd is not loaded, 2 = loaded
  # but not ready. The latter must fail closed rather than spawning a contender.
  if ! launchd_service_loaded; then
    return 1
  fi
  local launchd_pid lock_pid
  launchd_pid="$(launchd_service_pid)"
  lock_pid="$(live_supervisor_lock_owner)"
  if [[ -n "${launchd_pid}" && "${launchd_pid}" == "${lock_pid}" ]]; then
    return 0
  fi
  return 2
}

manual_start_owner_guard() {
  local launchd_state
  if launchd_owner_state 2>/dev/null; then
    launchd_state=0
  else
    launchd_state=$?
  fi
  case "${launchd_state}" in
    0)
      echo "Gateway already running under launchd; use scripts/openclaw-gateway-launchd.sh restart for lifecycle changes." >&2
      return 0
      ;;
    2)
      echo "Gateway launchd service is loaded but its supervisor is not ready; refusing a second supervisor. Check scripts/openclaw-gateway-launchd.sh status." >&2
      return 2
      ;;
  esac
  local owner_pid
  owner_pid="$(live_supervisor_lock_owner)"
  if [[ -n "${owner_pid}" ]]; then
    echo "Gateway already running (supervisor pid ${owner_pid}); refusing a second supervisor." >&2
    return 0
  fi
  return 1
}

case "${command}" in
  run)
    ensure_runtime_dirs
    ensure_gateway_config
    exec "${script_dir}/openclaw-local" gateway run "${common_args[@]}" "$@"
    ;;
  start)
    ensure_runtime_dirs
    ensure_gateway_config
    if manual_start_owner_guard; then
      exit 0
    else
      guard_rc=$?
      if [[ "${guard_rc}" -eq 2 ]]; then
        exit 1
      fi
    fi
    cleanup_stale_pid
    existing_pid="$(read_gateway_pid)"
    if gateway_pid_is_live "${existing_pid:-}"; then
      echo "Gateway already running (pid ${existing_pid})." >&2
      exit 0
    fi
    : > "${OPENCLAW_LOCAL_GATEWAY_LOG}"
    supervisor_meta_log="${OPENCLAW_LOCAL_LOGS}/gateway.supervisor.log"
    nohup perl -MPOSIX=setsid -e 'setsid() or die "setsid failed: $!"; exec @ARGV or die "exec failed: $!"' \
      "${script_dir}/openclaw-local-gateway-supervisor" "$@" \
      >>"${supervisor_meta_log}" 2>&1 < /dev/null &
    gateway_pid=$!
    disown "${gateway_pid}" 2>/dev/null || true
    echo "${gateway_pid}" > "${OPENCLAW_LOCAL_GATEWAY_PID}"
    for _ in $(seq 1 20); do
      lock_owner="$(live_supervisor_lock_owner)"
      if [[ -n "${lock_owner}" && "${lock_owner}" != "${gateway_pid}" ]]; then
        echo "Gateway start refused: spawned supervisor does not own the singleton lock; another owner is live." >&2
        kill "${gateway_pid}" 2>/dev/null || true
        rm -f "${OPENCLAW_LOCAL_GATEWAY_PID}"
        exit 1
      fi
      if "${script_dir}/openclaw-local-http-smoke.sh" >/dev/null 2>&1; then
        if [[ "${lock_owner}" == "${gateway_pid}" ]] && gateway_pid_is_live "${gateway_pid}"; then
          echo "Gateway started (pid ${gateway_pid})."
          echo "Log: ${OPENCLAW_LOCAL_GATEWAY_LOG}"
          exit 0
        fi
      fi
      sleep 1
      if ! gateway_pid_is_live "${gateway_pid}"; then
        echo "Gateway failed to stay up. Log: ${OPENCLAW_LOCAL_GATEWAY_LOG}" >&2
        rm -f "${OPENCLAW_LOCAL_GATEWAY_PID}"
        exit 1
      fi
    done
    echo "Gateway did not become ready in time. Log: ${OPENCLAW_LOCAL_GATEWAY_LOG}" >&2
    exit 1
    ;;
  stop)
    if launchd_service_loaded; then
      echo "Gateway is launchd-managed; refusing manual stop. Use scripts/openclaw-gateway-launchd.sh stop or restart." >&2
      exit 1
    fi
    cleanup_stale_pid
    existing_pid="$(read_gateway_pid)"
    if [[ -z "${existing_pid}" ]]; then
      echo "Gateway is not running."
      exit 0
    fi
    kill "${existing_pid}" 2>/dev/null || true
    for _ in $(seq 1 10); do
      if ! gateway_pid_is_live "${existing_pid}"; then
        rm -f "${OPENCLAW_LOCAL_GATEWAY_PID}"
        echo "Gateway stopped."
        exit 0
      fi
      sleep 1
    done
    kill -9 "${existing_pid}" 2>/dev/null || true
    rm -f "${OPENCLAW_LOCAL_GATEWAY_PID}"
    echo "Gateway force-stopped."
    ;;
  tail)
    ensure_runtime_dirs
    touch "${OPENCLAW_LOCAL_GATEWAY_LOG}"
    exec tail -n "${TAIL_LINES:-40}" -f "${OPENCLAW_LOCAL_GATEWAY_LOG}"
    ;;
  health)
    gateway_token="$(read_gateway_token)"
    if [[ -n "${gateway_token}" ]]; then
      # These one-shot commands must pass --token: with --url overridden the CLI
      # demands explicit credentials, and `gateway health` rejects --token-file.
      # The exposure window is a single short-lived process, unlike the long-running
      # ticker watcher, which now receives its token through the environment.
      # boundary-grep-allow: secret-on-command-line
      exec "${script_dir}/openclaw-local" gateway health --json --url "${OPENCLAW_LOCAL_GATEWAY_WS_URL}" --token "${gateway_token}" "$@"
    fi
    exec "${script_dir}/openclaw-local" gateway health --json --url "${OPENCLAW_LOCAL_GATEWAY_WS_URL}" "$@"
    ;;
  probe)
    gateway_token="$(read_gateway_token)"
    if [[ -n "${gateway_token}" ]]; then
      # boundary-grep-allow: secret-on-command-line
      exec "${script_dir}/openclaw-local" gateway probe --json --url "${OPENCLAW_LOCAL_GATEWAY_WS_URL}" --token "${gateway_token}" "$@"
    fi
    exec "${script_dir}/openclaw-local" gateway probe --json --url "${OPENCLAW_LOCAL_GATEWAY_WS_URL}" "$@"
    ;;
  status)
    cleanup_stale_pid
    existing_pid="$(read_gateway_pid)"
    if [[ -n "${existing_pid}" ]]; then
      echo "gateway_pid=${existing_pid}"
      echo "gateway_log=${OPENCLAW_LOCAL_GATEWAY_LOG}"
    else
      echo "gateway_pid=stopped"
      echo "gateway_log=${OPENCLAW_LOCAL_GATEWAY_LOG}"
    fi
    gateway_token="$(read_gateway_token)"
    if [[ -n "${gateway_token}" ]]; then
      # boundary-grep-allow: secret-on-command-line
      exec "${script_dir}/openclaw-local" gateway status --url "${OPENCLAW_LOCAL_GATEWAY_WS_URL}" --token "${gateway_token}" "$@"
    fi
    exec "${script_dir}/openclaw-local" gateway status --url "${OPENCLAW_LOCAL_GATEWAY_WS_URL}" "$@"
    ;;
  *)
    echo "Usage: scripts/openclaw-local-gateway [run|start|stop|tail|health|probe|status] [args...]" >&2
    exit 1
    ;;
esac
