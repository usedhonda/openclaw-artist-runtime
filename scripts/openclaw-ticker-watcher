#!/usr/bin/env node
import { appendFile, mkdir, readFile, unlink, writeFile } from "node:fs/promises";
import { dirname, resolve } from "node:path";
import { spawn } from "node:child_process";

function usage() {
  console.error("usage: openclaw-ticker-watcher --workspace <root> --gateway-url <url> --supervisor <script> [--token <token>] [--once]");
  process.exit(2);
}

function argValue(args, name, fallback) {
  const index = args.indexOf(name);
  if (index === -1 || index + 1 >= args.length) {
    return fallback;
  }
  return args[index + 1];
}

function numberArg(args, name, fallback) {
  const raw = argValue(args, name, undefined);
  if (raw === undefined) {
    return fallback;
  }
  const parsed = Number.parseInt(raw, 10);
  return Number.isFinite(parsed) ? parsed : fallback;
}

async function readJson(path) {
  return readFile(path, "utf8").then((text) => JSON.parse(text)).catch(() => undefined);
}

async function logLine(path, message) {
  await mkdir(dirname(path), { recursive: true });
  await appendFile(path, `[ticker-watcher ${new Date().toISOString()}] ${message}\n`, "utf8");
}

function processAlive(pid) {
  if (!Number.isFinite(pid) || pid <= 0) {
    return false;
  }
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function isStale(heartbeat, staleMs) {
  const raw = heartbeat?.lastTickAttempt ?? heartbeat?.updatedAt;
  const timestamp = typeof raw === "string" ? Date.parse(raw) : Number.NaN;
  return !Number.isFinite(timestamp) || Date.now() - timestamp > staleMs;
}

const DEFAULT_SAFE_TICK_RATE_LIMIT_MS = 5 * 60 * 1000;
const DEFAULT_SUPERVISOR_WAIT_LIMIT_MS = 5 * 60 * 1000;

let lastSafeTickAt = 0;
let supervisorWaitStartedAt;
let supervisorWaitPid;

async function triggerSafeTick(gatewayUrl, token) {
  const base = gatewayUrl.replace(/\/+$/, "");
  const response = await fetch(`${base}/plugins/artist-runtime/api/autopilot/safe-tick-trigger`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ token })
  });
  return {
    httpStatus: response.status,
    body: await response.json().catch(() => ({}))
  };
}

function spawnSupervisor(supervisor, args, logPath, reason) {
  const child = spawn(resolve(supervisor), args, {
    detached: true,
    stdio: "ignore"
  });
  child.unref();
  void logLine(logPath, `spawned supervisor pid=${child.pid} reason=${reason}`);
  return child.pid;
}

async function clearSupervisorWait(options) {
  supervisorWaitStartedAt = undefined;
  supervisorWaitPid = undefined;
  await unlink(options.escalationPath).catch((error) => {
    if (error?.code !== "ENOENT") {
      throw error;
    }
  });
}

async function escalateSupervisorWaitOnce(options, details) {
  await mkdir(dirname(options.escalationPath), { recursive: true });
  const payload = {
    type: "ticker_watcher_supervisor_wait_exceeded",
    createdAt: new Date().toISOString(),
    supervisorPid: details.supervisorPid,
    gatewayPid: details.gatewayPid || null,
    waitMs: details.waitMs
  };
  const created = await writeFile(options.escalationPath, `${JSON.stringify(payload, null, 2)}\n`, {
    encoding: "utf8",
    flag: "wx"
  }).then(() => true).catch((error) => {
    if (error?.code === "EEXIST") {
      return false;
    }
    throw error;
  });
  if (created) {
    await logLine(options.logPath, `escalation supervisor wait exceeded gateway pid=${details.gatewayPid || "unknown"} supervisor pid=${details.supervisorPid} waitMs=${details.waitMs}`);
  }
  return created;
}

async function runOnce(options) {
  const heartbeat = await readJson(`${options.workspace}/runtime/autopilot-heartbeat.json`);
  const supervisorHeartbeat = await readJson(`${options.workspace}/runtime/supervisor-heartbeat.json`);
  const supervisorPid = Number(supervisorHeartbeat?.pid ?? 0);
  const gatewayPid = Number(supervisorHeartbeat?.gateway?.pid ?? 0);
  const gatewayState = supervisorHeartbeat?.gateway?.state;
  const gatewayAlive = gatewayState === "running" && processAlive(gatewayPid);

  if (gatewayAlive) {
    await clearSupervisorWait(options);
    const heartbeatMatchesGateway = Number(heartbeat?.pid ?? 0) === gatewayPid;
    if (heartbeatMatchesGateway && !isStale(heartbeat, options.staleMs)) {
      await logLine(options.logPath, `ticker fresh; gateway pid=${gatewayPid}; no action`);
      return { action: "none", reason: "ticker_fresh" };
    }
    if (!options.token) {
      await logLine(options.logPath, `ticker stale or invalid; gateway pid=${gatewayPid} alive; safe tick skipped token_missing`);
      return { action: "blocked", reason: "token_missing" };
    }
    const elapsedSinceSafeTick = Date.now() - lastSafeTickAt;
    if (lastSafeTickAt > 0 && elapsedSinceSafeTick < options.safeTickRateLimitMs) {
      const retryAfterMs = options.safeTickRateLimitMs - elapsedSinceSafeTick;
      await logLine(options.logPath, `safe tick rate-limited gateway pid=${gatewayPid} retryAfterMs=${retryAfterMs}`);
      return { action: "rate_limited", reason: "safe_tick_rate_limited", retryAfterMs };
    }
    lastSafeTickAt = Date.now();
    const result = await triggerSafeTick(options.gatewayUrl, options.token);
    await logLine(options.logPath, `safe tick trigger gateway pid=${gatewayPid} http=${result.httpStatus} statusCode=${result.body?.statusCode ?? "unknown"} outcome=${result.body?.tickerOutcome ?? "unknown"}`);
    return { action: "safe_tick_trigger", reason: "ticker_stale_gateway_alive", result };
  }

  if (!supervisorHeartbeat) {
    // The supervisor heartbeat owns Gateway identity. Never fall back to the
    // autopilot heartbeat pid: that writer may be stale, orphaned, or unrelated.
    // Starting a contender is safe because the supervisor singleton lock rejects
    // it when an unreported owner is still alive.
    await clearSupervisorWait(options);
    await logLine(options.logPath, "supervisor heartbeat unavailable; refusing autopilot pid fallback");
    const pid = spawnSupervisor(options.supervisor, options.supervisorArgs, options.logPath, "supervisor_heartbeat_unavailable");
    return { action: "supervisor_restart", reason: "supervisor_heartbeat_unavailable", pid };
  }

  if (processAlive(supervisorPid)) {
    const now = Date.now();
    if (supervisorWaitPid !== supervisorPid) {
      supervisorWaitPid = supervisorPid;
      supervisorWaitStartedAt = now;
    }
    const waitMs = now - supervisorWaitStartedAt;
    const escalated = waitMs >= options.supervisorWaitLimitMs
      ? await escalateSupervisorWaitOnce(options, { supervisorPid, gatewayPid, waitMs })
      : false;
    await logLine(options.logPath, `gateway pid=${gatewayPid || "unknown"} unavailable; supervisor pid=${supervisorPid} alive waitMs=${waitMs}`);
    return { action: "wait_supervisor", reason: "gateway_dead_supervisor_alive", escalated };
  }

  await clearSupervisorWait(options);
  const pid = spawnSupervisor(options.supervisor, options.supervisorArgs, options.logPath, "gateway_pid_dead");
  return { action: "supervisor_restart", reason: "gateway_dead_supervisor_dead", pid };
}

async function main() {
  const args = process.argv.slice(2);
  const workspace = argValue(args, "--workspace", process.env.OPENCLAW_LOCAL_WORKSPACE);
  const gatewayUrl = argValue(args, "--gateway-url", process.env.OPENCLAW_LOCAL_GATEWAY_HTTP_URL ?? "http://127.0.0.1:43134");
  const supervisor = argValue(args, "--supervisor", "scripts/openclaw-local-gateway-supervisor");
  if (!workspace || !gatewayUrl || !supervisor) {
    usage();
  }
  const logPath = argValue(args, "--log", `${workspace}/runtime/ticker-watcher.log`);
  const staleMs = numberArg(args, "--stale-ms", 5 * 60 * 1000);
  const intervalMs = numberArg(args, "--interval-ms", 60 * 1000);
  const safeTickRateLimitMs = numberArg(args, "--safe-tick-rate-limit-ms", DEFAULT_SAFE_TICK_RATE_LIMIT_MS);
  const supervisorWaitLimitMs = numberArg(args, "--supervisor-wait-limit-ms", DEFAULT_SUPERVISOR_WAIT_LIMIT_MS);
  const token = argValue(args, "--token", process.env.OPENCLAW_SAFE_TICK_TRIGGER_TOKEN ?? process.env.OPENCLAW_TICKER_WATCHER_TOKEN);
  const escalationPath = argValue(args, "--escalation-path", `${workspace}/runtime/ticker-watcher-escalation.json`);
  const separator = args.indexOf("--");
  const supervisorArgs = separator === -1 ? [] : args.slice(separator + 1);
  const options = {
    workspace,
    gatewayUrl,
    supervisor,
    supervisorArgs,
    logPath,
    staleMs,
    token,
    safeTickRateLimitMs,
    supervisorWaitLimitMs,
    escalationPath
  };

  await logLine(logPath, `started pid=${process.pid} workspace=${workspace} staleMs=${staleMs}`);
  if (args.includes("--once")) {
    const result = await runOnce(options);
    console.log(JSON.stringify(result));
    return;
  }
  setInterval(() => {
    void runOnce(options).catch((error) => {
      void logLine(logPath, `error ${(error instanceof Error ? error.message : String(error))}`);
    });
  }, intervalMs);
  await runOnce(options);
}

await main();
